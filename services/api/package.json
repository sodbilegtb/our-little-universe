{
  "name": "@olu/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The Our Little Universe REST API: one Lambda behind API Gateway, plus a local Node server for development.",
  "scripts": {
    "dev": "tsx watch src/local/server.ts",
    "start": "tsx src/local/server.ts",
    "build": "node scripts/bundle.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:dynamodb": "vitest run src/repositories/repository.contract.test.ts",
    "hash-password": "tsx src/scripts/hashPassword.ts",
    "set-password": "tsx src/scripts/setAdminPassword.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1172.0",
    "@aws-sdk/client-ssm": "^3.1172.0",
    "@aws-sdk/lib-dynamodb": "^3.1172.0",
    "@olu/event-core": "*",
    "@olu/shared": "*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^22.19.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vitest": "^5.1.1"
  }
}
